<Window x:Class="CinemaApp.Wpf.Views.CinemaListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Explore Cinemas" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Explore Cinemas"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Cinemas}"
                  SelectedItem="{Binding SelectedCinema}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2"
                Content="Load Cinemas"
                Width="120"
                Height="35"
                HorizontalAlignment="Left"
                Command="{Binding LoadCinemasCommand}" />
    </Grid>
</Window>