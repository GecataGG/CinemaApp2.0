<Window x:Class="CinemaApp.Wpf.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register" Height="350" Width="400">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Email Input -->
            <TextBox Text="{Binding Email}" Width="300" Margin="10" PlaceholderText="Email" />

            <!-- Password Input -->
            <PasswordBox Password="{Binding Password}" Width="300" Margin="10" PlaceholderText="Password"/>

            <!-- Confirm Password Input -->
            <PasswordBox Password="{Binding ConfirmPassword}" Width="300" Margin="10" PlaceholderText="Confirm Password"/>

            <!-- Register Button -->
            <Button Content="Register" Command="{Binding RegisterCommand}" Width="300" Margin="10" />
        </StackPanel>
    </Grid>
</Window>
