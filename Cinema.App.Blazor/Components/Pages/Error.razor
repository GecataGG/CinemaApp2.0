@page "/error"
@page "/error/{statusCode:int}"
@attribute [AllowAnonymous]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<div class="container mt-5 text-center text-light">
    <div class="card bg-dark shadow-lg p-5 rounded">
        @if (StatusCode == 400)
        {
            <h1 class="text-warning fw-bold mb-3">
                <i class="bi bi-exclamation-circle"></i> 400 - Bad Request
            </h1>
            <p class="fs-5">
                The request you sent is invalid.
            </p>
        }
        else if (StatusCode == 404)
        {
            <h1 class="text-danger fw-bold mb-3">
                <i class="bi bi-search"></i> 404 - Not Found
            </h1>
            <p class="fs-5">
                The page or resource you are looking for does not exist.
            </p>
        }
        else if (StatusCode == 500)
        {
            <h1 class="text-danger fw-bold mb-3">
                <i class="bi bi-bug-fill"></i> 500 - Server Error
            </h1>
            <p class="fs-5">
                Something went wrong on our side. Please try again later.
            </p>
        }
        else
        {
            <h1 class="text-danger fw-bold mb-3">
                <i class="bi bi-exclamation-triangle-fill"></i> Something went wrong
            </h1>
            <p class="fs-5">
                An unexpected error occurred while processing your request.
            </p>
            @if (!string.IsNullOrEmpty(RequestId))
            {
                <p class="mt-3">
                    <strong>Request ID:</strong>
                    <code>@RequestId</code>
                </p>
            }
        }

        <div class="mt-4">
            <button class="btn btn-warning fw-bold px-4 rounded-pill" @onclick="GoHome">
                <i class="bi bi-house-door"></i> Back to Home
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? StatusCode { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized()
    {
        RequestId = System.Diagnostics.Activity.Current?.Id ?? System.Guid.NewGuid().ToString();
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}