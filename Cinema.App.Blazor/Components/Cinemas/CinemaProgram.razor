@page "/cinemas/program/{cinemaId:guid}"
@attribute [AllowAnonymous]

@using CinemaApp.Core.DTOs.Cinema
@using CinemaApp.Core.Interfaces.IServices
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject ICinemaService CinemaService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Program - @cinema?.Name</h1>

        <button class="btn btn-secondary" @onclick="GoToCinemas">
            Back to Cinemas
        </button>
    </div>

    @if (cinema == null)
    {
        <div class="text-center">
            <div class="spinner-border text-warning" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (cinema.ProjectionMovies == null || !cinema.ProjectionMovies.Any())
    {
        <div class="alert alert-info">
            No movies available for this cinema.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var movie in cinema.ProjectionMovies)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@(string.IsNullOrWhiteSpace(movie.ImageUrl)
                                                                                                                                           ? "https://m.media-amazon.com/images/M/MV5BMjAxMzY3NjcxNF5BMl5BanBnXkFtZTcwNTI5OTM0Mw@@._V1_.jpg"
                                                                                                                                           : movie.ImageUrl)"
                             class="card-img-top"
                             alt="@movie.Title"
                             style="height: 380px; object-fit: cover;" />

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@movie.Title</h5>

                            <p class="card-text mb-3">
                                <strong>Director:</strong> @movie.Director
                            </p>

                            <div class="mt-auto d-flex flex-wrap gap-2">
                                <button class="btn btn-primary btn-sm" @onclick="() => GoToMovieDetails(movie.Id)">
                                    View Details
                                </button>

                                @if (isAuthenticated)
                                {
                                    <button class="btn btn-outline-warning btn-sm" @onclick="() => AddToWatchlist(movie.Id)">
                                        Add to Watchlist
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid CinemaId { get; set; }

    private CinemaProgramDetailsDto? cinema;
    private bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        await LoadCinemaProgram();
        await CheckAuthStatus();
    }

    private async Task LoadCinemaProgram()
    {
        cinema = await CinemaService.GetCinemaProgramByIdAsync(CinemaId);
        StateHasChanged();
    }

    private async Task CheckAuthStatus()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
    }

    private void GoToCinemas()
    {
        Navigation.NavigateTo("/cinemas");
    }

    private void GoToMovieDetails(Guid movieId)
    {
        Navigation.NavigateTo($"/movies/details/{movieId}");
    }

    private void AddToWatchlist(Guid movieId)
    {
        // Ще добавим watchlist функционалност по-късно
        Navigation.NavigateTo($"/watchlist/add/{movieId}");
    }
}