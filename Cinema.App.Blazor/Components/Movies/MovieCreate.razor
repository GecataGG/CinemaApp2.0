@page "/movies/create"
@rendermode InteractiveServer
@attribute [Authorize]

@using CinemaApp.Core.Interfaces.IServices
@using CinemaApp.Core.ViewModels.Movie.WebMovie
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject IMovieService MovieService
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h2 class="fw-bold mb-4 text-center">Add New Movie</h2>

            <EditForm Model="@movieForm" OnValidSubmit="@HandleValidSubmit" class="card shadow-sm p-4">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger mb-3" />

                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <InputText @bind-Value="movieForm.Title" class="form-control" />
                    <ValidationMessage For="@(() => movieForm.Title)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Genre</label>
                    <InputSelect @bind-Value="movieForm.Genre" class="form-select">
                        <option value="">-- Select Genre --</option>
                        <option value="Action">Action</option>
                        <option value="Comedy">Comedy</option>
                        <option value="Drama">Drama</option>
                        <option value="Horror">Horror</option>
                        <option value="Romance">Romance</option>
                        <option value="Sci-Fi">Sci-Fi</option>
                        <option value="Thriller">Thriller</option>
                        <option value="Animation">Animation</option>
                        <option value="Adventure">Adventure</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => movieForm.Genre)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Director</label>
                    <InputText @bind-Value="movieForm.Director" class="form-control" />
                    <ValidationMessage For="@(() => movieForm.Director)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Duration (minutes)</label>
                    <InputNumber @bind-Value="movieForm.Duration" class="form-control" min="1" max="300" />
                    <ValidationMessage For="@(() => movieForm.Duration)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Release Date</label>
                    <InputDate @bind-Value="movieForm.ReleaseDate" class="form-control" />
                    <ValidationMessage For="@(() => movieForm.ReleaseDate)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea @bind-Value="movieForm.Description" class="form-control" rows="4" />
                    <ValidationMessage For="@(() => movieForm.Description)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Image URL</label>
                    <InputText @bind-Value="movieForm.ImageUrl" class="form-control" />
                    <ValidationMessage For="@(() => movieForm.ImageUrl)" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Create</button>
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
    
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
</div>

@code {
    private MovieFormModel movieForm = new();
    private string? errorMessage;

    private async Task HandleValidSubmit()
    {
        try
        {
            await MovieService.CreateMovieAsync(movieForm);
            Navigation.NavigateTo("/movies");
        }
        catch (Exception ex)
        {
            errorMessage = "Error creating movie.";
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/movies");
    }
}