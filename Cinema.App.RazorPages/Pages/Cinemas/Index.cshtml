@page
@model Cinema.App.RazorPages.Pages.Cinemas.IndexModel
@{
    ViewData["Title"] = "Explore Cinemas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Explore Cinemas</h1>
        
        <div>
            <a asp-page="/Cinemas/IndexWithFilters" class="btn btn-primary me-2">
                Filter View
            </a>
            <a asp-page="/Home/Index" class="btn btn-secondary">
                Back to Home
            </a>
        </div>
    </div>

    @if (!Model.ViewModel.Cinemas.Any())
    {
        <div class="alert alert-info">
            No cinemas available.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var cinema in Model.ViewModel.Cinemas)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@(cinema.Location == "Sofia" 
                                ? "https://images.unsplash.com/photo-1517602302552-471fe67acf66"
                                : "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba")"
                             class="card-img-top"
                             alt="@cinema.Name"
                             style="height: 220px; object-fit: cover;" />

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@cinema.Name</h5>

                            <p class="card-text mb-3">
                                <strong>Location:</strong> @cinema.Location
                            </p>

                            <div class="mt-auto">
                                <a asp-page="/Cinemas/Program"
                                       asp-route-id="@cinema.Id"
                                       class="btn btn-primary">
                                    View Program
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>