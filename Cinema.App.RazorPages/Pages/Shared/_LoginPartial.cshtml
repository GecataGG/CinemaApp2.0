@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-warning fw-bold" asp-page="/Watchlist/Index">
                <i class="bi bi-bookmark-heart"></i> My Watchlist
            </a>
        </li>
        
        <li class="nav-item">
            <a class="nav-link text-warning fw-bold"
                   asp-page="/Account/Manage/Index"
                   title="Manage">
                Hello, @UserManager.GetUserName(User)!
            </a>
        </li>

        <li class="nav-item">
            <form class="form-inline"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Page("/Home/Index", new { area = "" })"
                  method="post">
                <button type="submit" class="nav-link btn btn-link text-warning fw-bold border-0">
                    Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-warning fw-bold"
                   id="register"
                   asp-area="Identity"
                   asp-page="/Account/Register">
                Register
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-warning fw-bold"
                   id="login"
                   asp-area="Identity"
                   asp-page="/Account/Login">
                Login
            </a>
        </li>
    }
</ul>