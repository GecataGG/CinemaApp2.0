@page
@model Cinema.App.RazorPages.Pages.Movies.CreateModel
@{
    ViewData["Title"] = "Add New Movie";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h2 class="fw-bold mb-4 text-center">Add New Movie</h2>

            <form method="post" class="card shadow-sm p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="MovieForm.Title" class="form-label"></label>
                    <input asp-for="MovieForm.Title" class="form-control" />
                    <span asp-validation-for="MovieForm.Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MovieForm.Genre" class="form-label"></label>
                    <select asp-for="MovieForm.Genre" class="form-select">
                        <option value="">-- Select Genre --</option>
                        <option>Action</option>
                        <option>Comedy</option>
                        <option>Drama</option>
                        <option>Horror</option>
                        <option>Romance</option>
                        <option>Sci-Fi</option>
                        <option>Thriller</option>
                        <option>Animation</option>
                        <option>Adventure</option>
                    </select>
                    <span asp-validation-for="MovieForm.Genre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MovieForm.Director" class="form-label"></label>
                    <input asp-for="MovieForm.Director" class="form-control" />
                    <span asp-validation-for="MovieForm.Director" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MovieForm.Duration" class="form-label">Duration (minutes)</label>
                    <input asp-for="MovieForm.Duration" class="form-control" type="number" min="1" max="300" />
                    <span asp-validation-for="MovieForm.Duration" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MovieForm.ReleaseDate" class="form-label"></label>
                    <input asp-for="MovieForm.ReleaseDate" class="form-control" type="date" />
                    <span asp-validation-for="MovieForm.ReleaseDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MovieForm.Description" class="form-label"></label>
                    <textarea asp-for="MovieForm.Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="MovieForm.Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MovieForm.ImageUrl" class="form-label"></label>
                    <input asp-for="MovieForm.ImageUrl" class="form-control" />
                    <span asp-validation-for="MovieForm.ImageUrl" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Create</button>
                    <a asp-page="/Movies/Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}