@model IEnumerable<CinemaApp.Core.ViewModels.Movie.AllMoviesIndexViewModel>

@{
    ViewData["Title"] = "All Movies";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Explore Movies</h1>

        @if (User?.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Movie" asp-action="Create" class="btn btn-success fw-bold">
                Add Movie
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No movies available yet.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var movie in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@movie.ImageUrl"
                             class="card-img-top"
                             alt="@movie.Title"
                             style="height: 420px; object-fit: cover;">

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@movie.Title</h5>

                            <p class="card-text mb-1">
                                <strong>Genre:</strong> @movie.Genre
                            </p>

                            <p class="card-text mb-1">
                                <strong>Director:</strong> @movie.Director
                            </p>

                            <p class="card-text mb-3">
                                <strong>Release Date:</strong> @movie.ReleaseDate
                            </p>

                            <div class="mt-auto d-flex flex-wrap gap-2">
                                <a asp-controller="Movie"
                                   asp-action="Details"
                                   asp-route-id="@movie.Id"
                                   class="btn btn-primary btn-sm">
                                    View Details
                                </a>

                                @if (User?.Identity?.IsAuthenticated == true && !movie.IsInUserWatchlist)
                                {
                                    <a asp-controller="Watchlist"
                                       asp-action="Add"
                                       asp-route-id="@movie.Id"
                                       class="btn btn-outline-warning btn-sm">
                                        Add to Watchlist
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>