@model IEnumerable<CinemaApp.Core.ViewModels.Watchlist.WatchlistMovieViewModel>

@{
    ViewData["Title"] = "My Watchlist";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">My Watchlist</h1>

        <a asp-controller="Movie" asp-action="Index" class="btn btn-secondary">
            Back to Movies
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Your watchlist is empty.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var movie in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@movie.ImageUrl"
                             class="card-img-top"
                             alt="@movie.Title"
                             style="height: 420px; object-fit: cover;" />

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@movie.Title</h5>

                            <p class="card-text mb-1">
                                <strong>Genre:</strong> @movie.Genre
                            </p>

                            <p class="card-text mb-3">
                                <strong>Release Date:</strong> @movie.ReleaseDate
                            </p>

                            <div class="mt-auto d-flex gap-2 flex-wrap">
                                <a asp-controller="Movie"
                                   asp-action="Details"
                                   asp-route-id="@movie.MovieId"
                                   class="btn btn-primary btn-sm">
                                    View Details
                                </a>

                                <form asp-controller="Watchlist"
                                      asp-action="Remove"
                                      asp-route-movieId="@movie.MovieId"
                                      method="post"
                                      class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>