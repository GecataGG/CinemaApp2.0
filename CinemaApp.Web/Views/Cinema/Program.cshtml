@model CinemaApp.Core.ViewModels.Cinema.CinemaProgramViewModel

@{
    ViewData["Title"] = "Cinema Program";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Program - @Model.Name</h1>

        <a asp-controller="Cinema" asp-action="Index" class="btn btn-secondary">
            Back to Cinemas
        </a>
    </div>

    @if (!Model.ProjectionMovies.Any())
    {
        <div class="alert alert-info">
            No movies available for this cinema.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var movie in Model.ProjectionMovies)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@movie.ImageUrl"
                             class="card-img-top"
                             alt="@movie.Title"
                             style="height: 380px; object-fit: cover;" />

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@movie.Title</h5>

                            <p class="card-text mb-3">
                                <strong>Director:</strong> @movie.Director
                            </p>

                            <div class="mt-auto d-flex flex-wrap gap-2">
                                <a asp-controller="Movie"
                                   asp-action="Details"
                                   asp-route-id="@movie.Id"
                                   class="btn btn-primary btn-sm">
                                    View Details
                                </a>

                                @if (User?.Identity?.IsAuthenticated == true)
                                {
                                    <a asp-controller="Watchlist"
                                       asp-action="Add"
                                       asp-route-id="@movie.Id"
                                       class="btn btn-outline-warning btn-sm">
                                        Add to Watchlist
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>